<Window x:Class="MacroDoButler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macro Do Butler" Width="1180" Height="800" MinWidth="1000" MinHeight="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged" Closed="Window_Closed" SourceInitialized="Window_SourceInitialized" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Storyboard x:Key="BackgroundAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <ColorAnimation Storyboard.TargetName="GlowStop" Storyboard.TargetProperty="Color" From="#52101C" To="#8A1728" Duration="0:0:8" />
            <DoubleAnimation Storyboard.TargetName="ShapeOneTransform" Storyboard.TargetProperty="X" From="-18" To="26" Duration="0:0:14" />
            <DoubleAnimation Storyboard.TargetName="ShapeOneTransform" Storyboard.TargetProperty="Y" From="8" To="-16" Duration="0:0:11" />
            <DoubleAnimation Storyboard.TargetName="ShapeTwoTransform" Storyboard.TargetProperty="Angle" From="-7" To="7" Duration="0:0:18" />
            <DoubleAnimation Storyboard.TargetName="OrbTransform" Storyboard.TargetProperty="X" From="-28" To="24" Duration="0:0:16" />
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="20" BorderBrush="#53313B" BorderThickness="1" Background="#FF080B0F">
        <Border.Effect><DropShadowEffect Color="#D0000000" BlurRadius="34" ShadowDepth="10" Opacity="0.85" /></Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.Background>
                <RadialGradientBrush Center="0.78,0.17" GradientOrigin="0.78,0.17" RadiusX="0.85" RadiusY="0.9">
                    <GradientStop x:Name="GlowStop" Color="#52101C" Offset="0" />
                    <GradientStop Color="#16090E" Offset="0.42" />
                    <GradientStop Color="#080B0F" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <Canvas IsHitTestVisible="False" Opacity="0.5" ClipToBounds="True">
                <Polygon Points="720,-80 1050,20 880,330 655,175" Fill="#351521" RenderTransformOrigin="0.5,0.5">
                    <Polygon.RenderTransform><TranslateTransform x:Name="ShapeOneTransform" /></Polygon.RenderTransform>
                </Polygon>
                <Polygon Points="760,80 1010,220 850,410 695,250" Fill="#291018" Stroke="#4DE52B3D" StrokeThickness="1" RenderTransformOrigin="0.5,0.5">
                    <Polygon.RenderTransform><RotateTransform x:Name="ShapeTwoTransform" /></Polygon.RenderTransform>
                </Polygon>
                <Ellipse Width="430" Height="430" Canvas.Left="-230" Canvas.Top="430" Opacity="0.3">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#60231728" /><GradientStop Color="#00151720" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="OrbTransform" /></Ellipse.RenderTransform>
                </Ellipse>
                <Path Data="M 0 590 L 120 540 L 250 610" Stroke="#35E52B3D" StrokeThickness="1" />
                <Path Data="M 790 640 L 910 570 L 980 590" Stroke="#30FF3B4F" StrokeThickness="1" />
            </Canvas>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#DB0B0F14" BorderBrush="#242B34" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,0,14,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#251016" BorderBrush="#85404B" BorderThickness="1">
                                <Image Source="/assets/MacroDoButler.png" Margin="5" Stretch="Uniform" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MACRO DO BUTLER" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Controle personalizado com presets em tempo real" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SettingsButton" Width="40" Height="34" Style="{StaticResource WindowControlButtonStyle}" Click="Settings_Click" ToolTip="Configurações" AutomationProperties.Name="Configurações">
                                <Viewbox Width="19" Height="19" Stretch="Uniform">
                                    <Grid Width="24" Height="24">
                                        <Path Fill="#AAB1BD" Data="M19.14,12.94 C19.18,12.64 19.2,12.33 19.2,12 C19.2,11.67 19.18,11.36 19.13,11.06 L21.16,9.48 C21.34,9.34 21.39,9.09 21.27,8.88 L19.35,5.56 C19.23,5.35 18.98,5.27 18.76,5.36 L16.37,6.32 C15.88,5.93 15.33,5.61 14.74,5.38 L14.38,2.84 C14.35,2.6 14.14,2.42 13.9,2.42 L10.1,2.42 C9.86,2.42 9.65,2.6 9.62,2.84 L9.26,5.38 C8.67,5.61 8.12,5.93 7.63,6.32 L5.24,5.36 C5.02,5.27 4.77,5.35 4.65,5.56 L2.73,8.88 C2.61,9.09 2.66,9.34 2.84,9.48 L4.87,11.06 C4.82,11.36 4.8,11.67 4.8,12 C4.8,12.33 4.82,12.64 4.87,12.94 L2.84,14.52 C2.66,14.66 2.61,14.91 2.73,15.12 L4.65,18.44 C4.77,18.65 5.02,18.73 5.24,18.64 L7.63,17.68 C8.12,18.07 8.67,18.39 9.26,18.62 L9.62,21.16 C9.65,21.4 9.86,21.58 10.1,21.58 L13.9,21.58 C14.14,21.58 14.35,21.4 14.38,21.16 L14.74,18.62 C15.33,18.39 15.88,18.07 16.37,17.68 L18.76,18.64 C18.98,18.73 19.23,18.65 19.35,18.44 L21.27,15.12 C21.39,14.91 21.34,14.66 21.16,14.52 L19.14,12.94 Z" />
                                        <Ellipse Width="7" Height="7" Fill="#DB0B0F14" Stroke="#AAB1BD" StrokeThickness="1.5" />
                                    </Grid>
                                </Viewbox>
                            </Button>
                            <Button Content="—" Width="40" Height="34" Style="{StaticResource WindowControlButtonStyle}" FontSize="18" Click="Minimize_Click" />
                            <Button Content="×" Width="40" Height="34" Style="{StaticResource WindowControlButtonStyle}" FontSize="21" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="MainPage" Grid.Row="1" Margin="28,18,28,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="350" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                    <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="PRESETS" Foreground="{StaticResource AccentBrightBrush}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Gerencie suas configurações" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,18" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5"><TextBlock Text="Jogo" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" /><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" ToolTip="Escolha o jogo cujos presets você quer visualizar ou editar." /></StackPanel>
                                    <TextBlock x:Name="GameEmptyText" Text="Nenhum jogo cadastrado" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,0,0,3" Visibility="Collapsed" />
                                    <ComboBox x:Name="GameSelector" Style="{StaticResource ComboStyle}" SelectionChanged="Organization_SelectionChanged" />
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,5"><TextBlock Text="Preset" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" /><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" ToolTip="Selecione um preset para carregar os valores salvos. Depois de editar, clique em SALVAR para guardar as alterações." /></StackPanel>
                                    <TextBlock x:Name="PresetEmptyText" Text="Nenhum preset neste jogo" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="2,0,0,3" Visibility="Collapsed" />
                                    <ComboBox x:Name="PresetSelector" Style="{StaticResource ComboStyle}" SelectionChanged="PresetSelector_SelectionChanged" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,7"><TextBlock Text="Nome do preset" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" /><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" ToolTip="Digite um nome para criar um preset ou renomear o selecionado. Clique em SALVAR para confirmar." /></StackPanel>
                                    <TextBox x:Name="PresetName" Style="{StaticResource FieldStyle}" />
                                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button Content="SALVAR" Style="{StaticResource PrimaryButtonStyle}" Click="SavePreset_Click" />
                                        <Button Grid.Column="2" Content="EXCLUIR" Style="{StaticResource SecondaryButtonStyle}" Click="DeletePreset_Click" />
                                    </Grid>
                                    <Button Content="EDITAR JOGO / PRESETS" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" Click="EditCategory_Click" />
                                    <TextBlock x:Name="FeedbackText" Foreground="#7EE2A8" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="CONTROLE" Foreground="{StaticResource AccentBrightBrush}" FontWeight="SemiBold" FontSize="12" />
                                        <Border x:Name="StatusPill" Grid.Column="1" CornerRadius="10" Background="#342029" Padding="9,4"><TextBlock x:Name="StatusText" Text="DESLIGADO" Foreground="#9199A6" FontSize="10" FontWeight="SemiBold" /></Border>
                                    </Grid>
                                    <TextBlock x:Name="WeaponStatusText" Text="Arma ativa: Primária" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,4" />
                                    <TextBlock x:Name="HotkeySummary" Text="F1 liga/desliga  •  F2 alterna  •  F12 encerra" Foreground="{StaticResource MutedBrush}" FontSize="10.5" />
                                    <Button x:Name="ToggleButton" Content="LIGAR · F1" Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0" Click="Toggle_Click" />
                                    <Button x:Name="WeaponButton" Content="USAR SECUNDÁRIA · F2" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" Click="ToggleWeapon_Click" />
                                </StackPanel>
                            </Border>
                    </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                        <StackPanel>
                            <Border x:Name="PrimaryCard" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="ARMA PRIMÁRIA" Foreground="{StaticResource AccentBrightBrush}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="Perfil principal" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                        <Border x:Name="PrimaryActiveBadge" Grid.Column="1" CornerRadius="10" Background="#5AE52B3D" Padding="10,5"><TextBlock Text="ATIVA" FontSize="10" FontWeight="SemiBold" /></Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,24,0,8"><TextBlock Text="Força vertical" VerticalAlignment="Center" /><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" ToolTip="Define a velocidade do movimento vertical do mouse enquanto o macro está ativo. Valores maiores aumentam a força do movimento." /></StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="PrimaryVerticalSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="10000" Value="350" ValueChanged="Slider_ValueChanged" Tag="PrimaryVertical" Margin="0,0,14,0" />
                                        <TextBox x:Name="PrimaryVerticalText" Grid.Column="1" Style="{StaticResource FieldStyle}" Text="350" TextAlignment="Center" TextChanged="NumericText_TextChanged" LostFocus="NumericText_LostFocus" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,20,0,8"><TextBlock Text="Correção lateral" VerticalAlignment="Center" /><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" ToolTip="Ajusta o movimento horizontal do mouse. Use valores positivos para a direita e negativos para a esquerda." /></StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="PrimaryHorizontalSlider" Style="{StaticResource ModernSliderStyle}" Minimum="-5000" Maximum="5000" Value="0" ValueChanged="Slider_ValueChanged" Tag="PrimaryHorizontal" Margin="0,0,14,0" />
                                        <TextBox x:Name="PrimaryHorizontalText" Grid.Column="1" Style="{StaticResource FieldStyle}" Text="0" TextAlignment="Center" TextChanged="NumericText_TextChanged" LostFocus="NumericText_LostFocus" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SecondaryCard" Style="{StaticResource CardStyle}" Margin="0,18,0,0" Opacity="0.78">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="ARMA SECUNDÁRIA" Foreground="#FF8C99" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="Perfil alternativo" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                        <Border x:Name="SecondaryActiveBadge" Grid.Column="1" CornerRadius="10" Background="#252B34" Padding="10,5"><TextBlock Text="INATIVA" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /></Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,24,0,8"><TextBlock Text="Força vertical" VerticalAlignment="Center" /><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" ToolTip="Define a velocidade vertical usada quando a arma secundária está ativa. Valores maiores aumentam a força do movimento." /></StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="SecondaryVerticalSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="10000" Value="0" ValueChanged="Slider_ValueChanged" Tag="SecondaryVertical" Margin="0,0,14,0" />
                                        <TextBox x:Name="SecondaryVerticalText" Grid.Column="1" Style="{StaticResource FieldStyle}" Text="0" TextAlignment="Center" TextChanged="NumericText_TextChanged" LostFocus="NumericText_LostFocus" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,20,0,8"><TextBlock Text="Correção lateral" VerticalAlignment="Center" /><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" ToolTip="Ajusta o movimento horizontal da arma secundária. Use valores positivos para a direita e negativos para a esquerda." /></StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="SecondaryHorizontalSlider" Style="{StaticResource ModernSliderStyle}" Minimum="-5000" Maximum="5000" Value="0" ValueChanged="Slider_ValueChanged" Tag="SecondaryHorizontal" Margin="0,0,14,0" />
                                        <TextBox x:Name="SecondaryHorizontalText" Grid.Column="1" Style="{StaticResource FieldStyle}" Text="0" TextAlignment="Center" TextChanged="NumericText_TextChanged" LostFocus="NumericText_LostFocus" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="18">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Border CornerRadius="3" Background="{StaticResource AccentBrush}" />
                                    <StackPanel Grid.Column="2"><TextBlock Text="AJUSTE PROPORCIONAL" FontWeight="SemiBold" FontSize="11" /><TextBlock Text="Os valores utilizam pixels por segundo, mantendo a intensidade consistente ao alterar o intervalo." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="SettingsPage" Grid.Row="1" Margin="38,24,38,26" Visibility="Collapsed">
                    <Grid Width="900" MaxWidth="900" HorizontalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="CONFIGURAÇÕES" Foreground="{StaticResource AccentBrightBrush}" FontWeight="SemiBold" FontSize="19" /><TextBlock Text="Preferências do aplicativo" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
                            <Button Grid.Column="1" Content="VOLTAR" Style="{StaticResource SecondaryButtonStyle}" Width="110" Click="Settings_Click" />
                        </Grid>
                        <TabControl Grid.Row="1" Style="{StaticResource DarkTabControlStyle}" ItemContainerStyle="{StaticResource DarkTabItemStyle}">
                            <TabItem Header="ATALHOS">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="24,26">
                                        <StackPanel>
                                            <TextBlock Text="ATALHOS" Foreground="{StaticResource AccentBrightBrush}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="Atalhos globais, ativos também em segundo plano" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,18" TextWrapping="Wrap" />
                                            <ItemsControl x:Name="HotkeyItems" />
                                            <TextBlock x:Name="HotkeyCaptureStatus" Foreground="#FF8C99" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap" />
                                            <TextBlock x:Name="HotkeyStatus" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                                            <Button Content="RESTAURAR PADRÕES" Style="{StaticResource SecondaryButtonStyle}" Margin="0,22,0,0" Click="RestoreHotkeys_Click" />
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="MACRO">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="24,26">
                                        <StackPanel>
                                            <TextBlock Text="CONFIGURAÇÕES DO MACRO" Foreground="{StaticResource AccentBrightBrush}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="O intervalo é geral e se aplica a todos os presets." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,4" />
                                            <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Intervalo" VerticalAlignment="Center" /><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" ToolTip="Define o tempo, em milissegundos, entre os ciclos do macro. É uma configuração geral e vale para todos os presets." /></StackPanel>
                                                <TextBox x:Name="IntervalText" Grid.Column="1" Style="{StaticResource FieldStyle}" Text="7" TextAlignment="Center" TextChanged="NumericText_TextChanged" LostFocus="NumericText_LostFocus" />
                                            </Grid>
                                            <Slider x:Name="IntervalSlider" Style="{StaticResource ModernSliderStyle}" Minimum="2" Maximum="50" Value="7" Margin="0,10,0,16" ValueChanged="Slider_ValueChanged" Tag="Interval" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="RequireRight" Content="Exigir botão direito pressionado" IsChecked="True" Style="{StaticResource ModernCheckStyle}" /><Button Content="?" Style="{StaticResource HelpIconButtonStyle}" ToolTip="Quando ativado, o macro só movimenta o mouse enquanto os botões esquerdo e direito estiverem pressionados." /></StackPanel>
                                            <TextBlock x:Name="MacroSettingsStatus" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="DADOS E BACKUP">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="24,26">
                                        <StackPanel>
                                            <TextBlock Text="TRANSFERÊNCIA E BACKUP" Foreground="{StaticResource AccentBrightBrush}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="Exporte seus presets ou recupere uma cópia de segurança." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,18" />
                                            <Button Content="EXPORTAR PRESETS" Style="{StaticResource SecondaryButtonStyle}" Click="ExportPresets_Click" ToolTip="Salvar uma cópia de todos os presets em JSON." />
                                            <Button Content="IMPORTAR PRESETS" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" Click="ImportPresets_Click" ToolTip="Importar arquivos JSON ou CFG legados." />
                                            <Button Content="CRIAR BACKUP" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" Click="CreateBackup_Click" ToolTip="Criar um backup do arquivo atual de presets." />
                                            <Button Content="RESTAURAR BACKUP" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" Click="RestoreBackup_Click" ToolTip="Selecionar e restaurar um backup anterior." />
                                            <TextBlock x:Name="TransferFeedbackText" Foreground="#7EE2A8" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
