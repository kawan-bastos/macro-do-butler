<Window x:Class="MacroDoButler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macro Do Butler" Width="980" Height="720" MinWidth="900" MinHeight="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged" Closed="Window_Closed">
    <Window.Resources>
        <Storyboard x:Key="BackgroundAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <ColorAnimation Storyboard.TargetName="GlowStop" Storyboard.TargetProperty="Color" From="#52101C" To="#8A1728" Duration="0:0:8" />
            <DoubleAnimation Storyboard.TargetName="ShapeOneTransform" Storyboard.TargetProperty="X" From="-18" To="26" Duration="0:0:14" />
            <DoubleAnimation Storyboard.TargetName="ShapeOneTransform" Storyboard.TargetProperty="Y" From="8" To="-16" Duration="0:0:11" />
            <DoubleAnimation Storyboard.TargetName="ShapeTwoTransform" Storyboard.TargetProperty="Angle" From="-7" To="7" Duration="0:0:18" />
            <DoubleAnimation Storyboard.TargetName="OrbTransform" Storyboard.TargetProperty="X" From="-28" To="24" Duration="0:0:16" />
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="20" BorderBrush="#53313B" BorderThickness="1" Background="#FF080B0F">
        <Border.Effect><DropShadowEffect Color="#D0000000" BlurRadius="34" ShadowDepth="10" Opacity="0.85" /></Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.Background>
                <RadialGradientBrush Center="0.78,0.17" GradientOrigin="0.78,0.17" RadiusX="0.85" RadiusY="0.9">
                    <GradientStop x:Name="GlowStop" Color="#52101C" Offset="0" />
                    <GradientStop Color="#16090E" Offset="0.42" />
                    <GradientStop Color="#080B0F" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <Canvas IsHitTestVisible="False" Opacity="0.5" ClipToBounds="True">
                <Polygon Points="720,-80 1050,20 880,330 655,175" Fill="#351521" RenderTransformOrigin="0.5,0.5">
                    <Polygon.RenderTransform><TranslateTransform x:Name="ShapeOneTransform" /></Polygon.RenderTransform>
                </Polygon>
                <Polygon Points="760,80 1010,220 850,410 695,250" Fill="#291018" Stroke="#4DE52B3D" StrokeThickness="1" RenderTransformOrigin="0.5,0.5">
                    <Polygon.RenderTransform><RotateTransform x:Name="ShapeTwoTransform" /></Polygon.RenderTransform>
                </Polygon>
                <Ellipse Width="430" Height="430" Canvas.Left="-230" Canvas.Top="430" Opacity="0.3">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#60231728" /><GradientStop Color="#00151720" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="OrbTransform" /></Ellipse.RenderTransform>
                </Ellipse>
                <Path Data="M 0 590 L 120 540 L 250 610" Stroke="#35E52B3D" StrokeThickness="1" />
                <Path Data="M 790 640 L 910 570 L 980 590" Stroke="#30FF3B4F" StrokeThickness="1" />
            </Canvas>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#DB0B0F14" BorderBrush="#242B34" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,0,14,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#251016" BorderBrush="#85404B" BorderThickness="1">
                                <Image Source="/assets/MacroDoButler.png" Margin="5" Stretch="Uniform" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MACRO DO BUTLER" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Controle personalizado com presets em tempo real" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="—" Width="40" Height="34" Background="Transparent" Foreground="#AAB1BD" BorderThickness="0" FontSize="18" Click="Minimize_Click" Cursor="Hand" />
                            <Button Content="×" Width="40" Height="34" Background="Transparent" Foreground="#AAB1BD" BorderThickness="0" FontSize="21" Click="Close_Click" Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="28,24,28,28">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="PRESETS" Foreground="{StaticResource AccentBrightBrush}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Gerencie suas configurações" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,18" />
                                    <TextBlock Text="Preset salvo" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,7" />
                                    <ComboBox x:Name="PresetList" Style="{StaticResource ComboStyle}" SelectionChanged="PresetList_SelectionChanged" />
                                    <TextBlock Text="Nome para salvar" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,14,0,7" />
                                    <TextBox x:Name="PresetName" Style="{StaticResource FieldStyle}" />
                                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Button Content="SALVAR" Style="{StaticResource PrimaryButtonStyle}" Click="SavePreset_Click" />
                                        <Button Grid.Column="2" Content="EXCLUIR" Style="{StaticResource SecondaryButtonStyle}" Click="DeletePreset_Click" />
                                    </Grid>
                                    <TextBlock x:Name="FeedbackText" Foreground="#7EE2A8" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="CONFIGURAÇÕES" Foreground="{StaticResource AccentBrightBrush}" FontWeight="SemiBold" FontSize="12" />
                                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="74" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Intervalo" VerticalAlignment="Center" />
                                        <TextBox x:Name="IntervalText" Grid.Column="1" Style="{StaticResource FieldStyle}" Text="7" TextAlignment="Center" TextChanged="NumericText_TextChanged" LostFocus="NumericText_LostFocus" />
                                    </Grid>
                                    <Slider x:Name="IntervalSlider" Style="{StaticResource ModernSliderStyle}" Minimum="2" Maximum="50" Value="7" Margin="0,10,0,16" ValueChanged="Slider_ValueChanged" Tag="Interval" />
                                    <CheckBox x:Name="RequireRight" Content="Exigir botão direito pressionado" IsChecked="True" Style="{StaticResource ModernCheckStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="CONTROLE" Foreground="{StaticResource AccentBrightBrush}" FontWeight="SemiBold" FontSize="12" />
                                        <Border x:Name="StatusPill" Grid.Column="1" CornerRadius="10" Background="#342029" Padding="9,4"><TextBlock x:Name="StatusText" Text="DESLIGADO" Foreground="#9199A6" FontSize="10" FontWeight="SemiBold" /></Border>
                                    </Grid>
                                    <TextBlock x:Name="WeaponStatusText" Text="Arma ativa: Primária" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,4" />
                                    <TextBlock Text="F1 liga/desliga  •  F2 alterna  •  F12 encerra" Foreground="{StaticResource MutedBrush}" FontSize="10.5" />
                                    <Button x:Name="ToggleButton" Content="LIGAR · F1" Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0" Click="Toggle_Click" />
                                    <Button x:Name="WeaponButton" Content="USAR SECUNDÁRIA · F2" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" Click="ToggleWeapon_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border x:Name="PrimaryCard" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="ARMA PRIMÁRIA" Foreground="{StaticResource AccentBrightBrush}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="Perfil principal" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                        <Border x:Name="PrimaryActiveBadge" Grid.Column="1" CornerRadius="10" Background="#5AE52B3D" Padding="10,5"><TextBlock Text="ATIVA" FontSize="10" FontWeight="SemiBold" /></Border>
                                    </Grid>
                                    <TextBlock Text="Força vertical" Margin="0,24,0,8" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="PrimaryVerticalSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="10000" Value="350" ValueChanged="Slider_ValueChanged" Tag="PrimaryVertical" Margin="0,0,14,0" />
                                        <TextBox x:Name="PrimaryVerticalText" Grid.Column="1" Style="{StaticResource FieldStyle}" Text="350" TextAlignment="Center" TextChanged="NumericText_TextChanged" LostFocus="NumericText_LostFocus" />
                                    </Grid>
                                    <TextBlock Text="Correção lateral" Margin="0,20,0,8" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="PrimaryHorizontalSlider" Style="{StaticResource ModernSliderStyle}" Minimum="-5000" Maximum="5000" Value="0" ValueChanged="Slider_ValueChanged" Tag="PrimaryHorizontal" Margin="0,0,14,0" />
                                        <TextBox x:Name="PrimaryHorizontalText" Grid.Column="1" Style="{StaticResource FieldStyle}" Text="0" TextAlignment="Center" TextChanged="NumericText_TextChanged" LostFocus="NumericText_LostFocus" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SecondaryCard" Style="{StaticResource CardStyle}" Margin="0,18,0,0" Opacity="0.78">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="ARMA SECUNDÁRIA" Foreground="#FF8C99" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="Perfil alternativo" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                        <Border x:Name="SecondaryActiveBadge" Grid.Column="1" CornerRadius="10" Background="#252B34" Padding="10,5"><TextBlock Text="INATIVA" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /></Border>
                                    </Grid>
                                    <TextBlock Text="Força vertical" Margin="0,24,0,8" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="SecondaryVerticalSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="10000" Value="0" ValueChanged="Slider_ValueChanged" Tag="SecondaryVertical" Margin="0,0,14,0" />
                                        <TextBox x:Name="SecondaryVerticalText" Grid.Column="1" Style="{StaticResource FieldStyle}" Text="0" TextAlignment="Center" TextChanged="NumericText_TextChanged" LostFocus="NumericText_LostFocus" />
                                    </Grid>
                                    <TextBlock Text="Correção lateral" Margin="0,20,0,8" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                        <Slider x:Name="SecondaryHorizontalSlider" Style="{StaticResource ModernSliderStyle}" Minimum="-5000" Maximum="5000" Value="0" ValueChanged="Slider_ValueChanged" Tag="SecondaryHorizontal" Margin="0,0,14,0" />
                                        <TextBox x:Name="SecondaryHorizontalText" Grid.Column="1" Style="{StaticResource FieldStyle}" Text="0" TextAlignment="Center" TextChanged="NumericText_TextChanged" LostFocus="NumericText_LostFocus" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="18">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Border CornerRadius="3" Background="{StaticResource AccentBrush}" />
                                    <StackPanel Grid.Column="2"><TextBlock Text="AJUSTE PROPORCIONAL" FontWeight="SemiBold" FontSize="11" /><TextBlock Text="Os valores utilizam pixels por segundo, mantendo a intensidade consistente ao alterar o intervalo." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
